{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuning Studio",
  "version": "0.1.2",
  "identifier": "dev.hxyulin.tuning-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Tuning Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Live inspection, tuning and telemetry for embedded firmware"
  }
}
