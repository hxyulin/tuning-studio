{
  "name": "tuning-studio",
  "displayName": "Tuning Studio",
  "description": "Live variable inspection, tuning, telemetry and task timelines for embedded firmware",
  "version": "0.1.2",
  "publisher": "hxyulin",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:probe-rs-debug",
    "onWebviewPanel:tuningStudio"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tuningStudio.open",
        "title": "Open Scope",
        "category": "Tuning Studio",
        "icon": "$(graph-line)"
      },
      {
        "command": "tuningStudio.openElf",
        "title": "Open Firmware ELF…",
        "category": "Tuning Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tuningStudio.connect",
        "title": "Connect Target…",
        "category": "Tuning Studio",
        "icon": "$(plug)",
        "enablement": "!tuningStudio.connected"
      },
      {
        "command": "tuningStudio.disconnect",
        "title": "Disconnect Target",
        "category": "Tuning Studio",
        "icon": "$(debug-disconnect)",
        "enablement": "tuningStudio.connected"
      },
      {
        "command": "tuningStudio.startRecording",
        "title": "Start Recording",
        "category": "Tuning Studio",
        "icon": "$(record)",
        "enablement": "tuningStudio.connected && !tuningStudio.recording"
      },
      {
        "command": "tuningStudio.stopRecording",
        "title": "Stop Recording",
        "category": "Tuning Studio",
        "icon": "$(debug-stop)",
        "enablement": "tuningStudio.recording"
      },
      {
        "command": "tuningStudio.showLogs",
        "title": "Show Firmware Log",
        "category": "Tuning Studio",
        "icon": "$(output)"
      },
      {
        "command": "tuningStudio.targetActions",
        "title": "Target Actions…",
        "category": "Tuning Studio"
      },
      {
        "command": "tuningStudio.showSource",
        "title": "Go to Source",
        "category": "Tuning Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tuningStudio.plotSymbol",
        "title": "Plot Symbol",
        "category": "Tuning Studio",
        "icon": "$(add)"
      },
      {
        "command": "tuningStudio.setRate",
        "category": "Tuning Studio",
        "title": "Change Sample Rate…",
        "enablement": "tuningStudio.connected"
      },
      {
        "command": "tuningStudio.reconnect",
        "title": "Reconnect Previous Target",
        "category": "Tuning Studio",
        "enablement": "!tuningStudio.connected"
      }
    ],
    "configuration": {
      "title": "Tuning Studio",
      "properties": {
        "tuningStudio.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `studio-server` binary. Empty uses the one bundled with the extension, else the newest `target/{release,debug}/studio-server` in the workspace or next to the extension."
        },
        "tuningStudio.mockTarget": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Connect the Probe source to an in-memory target holding the ELF's initialised data, instead of real hardware (runs `studio-server --mock`)."
        },
        "tuningStudio.sampleRateHz": {
          "type": "number",
          "default": 100,
          "enum": [
            10,
            50,
            100,
            200,
            500,
            1000
          ],
          "description": "Initial sample rate for native target connections. Change a running session from Target Actions."
        },
        "tuningStudio.swdSpeedKhz": {
          "type": "number",
          "default": 4000,
          "minimum": 1,
          "description": "SWD clock in kHz when launch.json does not specify a speed."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tuningStudio",
          "title": "Tuning Studio",
          "icon": "resources/studio.svg"
        }
      ]
    },
    "views": {
      "tuningStudio": [
        {
          "id": "tuningStudio.target",
          "name": "Target"
        },
        {
          "id": "tuningStudio.symbols",
          "name": "Symbols"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tuningStudio.symbols",
        "contents": "Open a firmware ELF to browse its symbols.\n[Open Firmware ELF](command:tuningStudio.openElf)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tuningStudio.open",
          "when": "view == tuningStudio.target",
          "group": "navigation"
        },
        {
          "command": "tuningStudio.openElf",
          "when": "view == tuningStudio.symbols",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tuningStudio.plotSymbol",
          "when": "view == tuningStudio.symbols && viewItem =~ /^studioSymbol/",
          "group": "inline"
        },
        {
          "command": "tuningStudio.showSource",
          "when": "view == tuningStudio.symbols && viewItem == studioSymbolSource",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "tuningStudio.openElf",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "tuningStudio"
        }
      ],
      "commandPalette": [
        {
          "command": "tuningStudio.showSource",
          "when": "false"
        },
        {
          "command": "tuningStudio.plotSymbol",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "webview": "npm --prefix .. run build:webview",
    "smoke": "node esbuild.mjs && node dist/smoke.js",
    "harness": "node esbuild.mjs && node dist/harness.js",
    "test:webview": "node scripts/webviewBridge.mjs",
    "test:recovery": "node scripts/connectionRecovery.mjs",
    "test:inspector": "node scripts/inspectorLab.mjs",
    "test:trace": "node scripts/taskTrace.mjs"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/vscode": "~1.140.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hxyulin/tuning-tools.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/hxyulin/tuning-tools",
  "bugs": {
    "url": "https://github.com/hxyulin/tuning-tools/issues"
  }
}
